{
  "name": "@bits/web",
  "private": true,
  "type": "module",
  "imports": {
    "#platform": {
      "workerd": "./app/platform/platform.worker.ts",
      "default": "./app/platform/platform.node.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "build": "NODE_ENV=production node --import remix/node-tsx scripts/build.ts",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime false --strict-vars false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file ../../packages/db/seed/local.sql && pnpm content:seed:local",
    "content": "node --import remix/node-tsx scripts/content.ts",
    "og": "NODE_ENV=test node --import remix/node-tsx scripts/og-images.ts",
    "content:seed:local": "node --import remix/node-tsx scripts/content.ts upload --all --publish",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "doctor": "remix doctor"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bits/db": "workspace:*",
    "@bits/ui": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remix": "^3.1.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.6.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
