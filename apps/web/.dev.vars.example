# Copy to .dev.vars for `pnpm preview` (wrangler dev) and the Node dev server.
# Everything here is optional outside production: missing values fall back to
# development defaults (a fixed session secret).
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# OAuth apps registered with callback http://localhost:44100/auth/oauth/<provider>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Live prompts (decision 019). The Anthropic key is stored in the AI Gateway
# (BYOK), so the gateway token is all a live run needs. Until it and both
# gateway vars are set, /api/run answers with the lesson's example output.
# The gateway vars live in wrangler.jsonc; override them here for dev.
# Tests never use these.
# CF_AIG_TOKEN=
# AI_GATEWAY_ACCOUNT_ID=
# AI_GATEWAY_ID=bits
# Only for a gateway without stored keys or auth. When set, it is sent with
# every request and overrides the gateway's stored key, so leave it unset.
# ANTHROPIC_API_KEY=
