// Cloudflare Workers config for the Bits web app.
// See docs/decisions/ for why each piece is shaped this way.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bits",
  // Bundled by scripts/build.ts (`pnpm build`), not by wrangler: the build has
  // to rewrite each module's import.meta.url so clientEntry IDs stay unique.
  "main": "build/worker/index.js",
  // The newest date the installed workerd supports, so `wrangler dev` and
  // production run the same runtime semantics. Bump with wrangler upgrades.
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  // The public address. Cloudflare creates the DNS record and certificate
  // (yogan.dev is a zone on this account). The workers.dev host stays on
  // for version previews and 301s to here (worker.ts, LEGACY_HOSTS).
  "routes": [{ "pattern": "bits.yogan.dev", "custom_domain": true }],

  // Fingerprinted browser modules, CSS and fonts compiled ahead of time by
  // scripts/build.ts, plus apps/web/public. Requests that match a file are
  // served by the platform without invoking the Worker.
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bits-db",
      "database_id": "163b946d-2eeb-443f-a5ed-59ad7f0a945d",
      // Plain SQL files applied by `wrangler d1 migrations apply`.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // Compiled course content: courses/{slug}/v{n}/manifest.json and
  // lessons/{lesson}.json, immutable per version (decision 018). Read
  // through the binding only; the bucket is never public.
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "bits-content"
    }
  ],

  // Sign-in email (Cloudflare Email Sending, beta). bits.yogan.dev is
  // onboarded with SPF/DKIM; the binding may only send from this address.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["signin@bits.yogan.dev"]
    }
  ],

  // Non-secret config. Secrets (SESSION_SECRET,
  // GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET) are set with
  // `wrangler secret put`, and locally in .dev.vars (see .dev.vars.example).
  "vars": {
    "APP_ENV": "production",
    "EMAIL_FROM": "signin@bits.yogan.dev",
    "CANONICAL_ORIGIN": "https://bits.yogan.dev",
    // Hosts that redirect to CANONICAL_ORIGIN (comma-separated).
    "LEGACY_HOSTS": "bits.ryanyogan.workers.dev"
  },

  // Daily housekeeping: delete expired sessions and email tokens (worker.ts).
  "triggers": {
    "crons": ["17 4 * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
