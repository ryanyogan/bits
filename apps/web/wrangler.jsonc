// Cloudflare Workers config for the Bits web app.
// See docs/decisions/ for why each piece is shaped this way.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bits",
  // Bundled by scripts/build.ts (`pnpm build`), not by wrangler: the build has
  // to rewrite each module's import.meta.url so clientEntry IDs stay unique.
  "main": "build/worker/index.js",
  // The newest date the installed workerd supports, so `wrangler dev` and
  // production run the same runtime semantics. Bump with wrangler upgrades.
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  // Off: a preview URL would be a second full host on the production D1, R2,
  // email and secrets (decision 020). Turn it on only with separate
  // preview resources.
  "preview_urls": false,
  // Run next to D1, not next to the visitor: a page makes several
  // sequential D1 round trips (decision 020). The D1 primary (ENAM, no read
  // replicas) and the R2 bucket are served from ORD, and this hint lands the
  // Worker in ORD (`cf-placement: remote-ORD`). Pinned at the owner's request
  // on 2026-10-26: Smart Placement never settled next to D1 (it showed
  // `local-*`, then `remote-ATL`). Static assets never invoke the Worker, so
  // they are unaffected.
  "placement": { "region": "azure:northcentralus" },
  // The public address. Cloudflare creates the DNS record and certificate
  // (yogan.dev is a zone on this account). The workers.dev host stays on
  // and 301s to here (worker.ts, LEGACY_HOSTS).
  "routes": [{ "pattern": "bits.yogan.dev", "custom_domain": true }],

  // Fingerprinted browser modules, CSS and fonts compiled ahead of time by
  // scripts/build.ts, plus apps/web/public. Requests that match a file are
  // served by the platform without invoking the Worker.
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bits-db",
      "database_id": "163b946d-2eeb-443f-a5ed-59ad7f0a945d",
      // Plain SQL files applied by `wrangler d1 migrations apply`.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // Compiled course content: courses/{slug}/v{n}/manifest.json and
  // lessons/{lesson}.json, immutable per version (decision 018). Read
  // through the binding only; the bucket is never public.
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "bits-content"
    }
  ],

  // Sign-in email (Cloudflare Email Sending, beta). bits.yogan.dev is
  // onboarded with SPF/DKIM; the binding may only send from this address.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["signin@bits.yogan.dev"]
    }
  ],

  // Burst limits per user or IP, one per tier (app/middleware/rate-limit.tsx,
  // decision 020). namespace_id is any integer unique within the account;
  // nothing has to be created first. Periods can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_WRITES", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SIGNIN", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_RUNS", "namespace_id": "2003", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_REPORTS", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } }
  ],

  // Non-secret config. Secrets (SESSION_SECRET,
  // GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET, CF_AIG_TOKEN) are set with `wrangler secret put`, and locally in
  // .dev.vars (see .dev.vars.example).
  "vars": {
    "APP_ENV": "production",
    "EMAIL_FROM": "signin@bits.yogan.dev",
    "CANONICAL_ORIGIN": "https://bits.yogan.dev",
    // Hosts that redirect to CANONICAL_ORIGIN (comma-separated).
    "LEGACY_HOSTS": "bits.ryanyogan.workers.dev",
    // Live prompts (decision 019): Anthropic through this AI Gateway, with
    // the key stored in the gateway (BYOK). Runs fall back to the lesson's
    // example output until the account id, the gateway and CF_AIG_TOKEN
    // are all set.
    "AI_GATEWAY_ACCOUNT_ID": "8ad084035b854467eb9d93ae3363d40b",
    "AI_GATEWAY_ID": "bits",
    // Spend guard: live model runs per UTC day, for everyone.
    "RUN_DAILY_LIVE_CAP": "1000"
  },

  // Daily housekeeping: delete expired sessions and email tokens, and
  // signed-out prompt runs older than a week (worker.ts).
  "triggers": {
    "crons": ["17 4 * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
