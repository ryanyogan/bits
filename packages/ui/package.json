{
  "name": "@bits/ui",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./assets": "./src/assets.ts",
    "./styles/*.css": "./src/styles/*.css",
    "./fonts/*": "./src/fonts/*",
    "./lib/ask-client": "./src/lib/ask-client.ts",
    "./lib/drafts": "./src/lib/drafts.ts",
    "./lib/field": "./src/lib/field.ts",
    "./lib/prefetch": "./src/lib/prefetch.ts",
    "./lib/states": "./src/lib/states.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.ts",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && remix test --config packages/ui/remix.json"
  },
  "peerDependencies": {
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@types/node": "^24.6.0",
    "playwright": "1.64.1",
    "remix": "^3.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@remix-run/ui": "0.13.0"
  }
}
